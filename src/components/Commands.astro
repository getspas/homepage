---
import Icon from './Icon.astro';
import { tokenizeCommand } from '../lib/shell';

const commands = [
	{
		id: 'link',
		sig: 'spas link <owner>/<repo>',
		desc: 'Connect this workspace to a dedicated GitHub repository. An anonymous visibility probe warns you if that repository is publicly readable.',
		example: 'spas link acme/app-assets --transport ssh --branch main',
		flags: [
			{ flag: '--transport https|ssh', desc: 'Transport for owner/repo references' },
			{ flag: '--branch NAME', desc: 'Target branch; required for an empty repository' },
			{ flag: '--dry-run', desc: 'Preview link settings without saving or network access' },
		],
	},
	{
		id: 'add',
		sig: 'spas add <path>...',
		desc: 'Enroll files under management and write their exclusions into .git/info/exclude. Passing a directory enrolls every regular file inside it.',
		example: 'spas add testdata/ .env.local AGENTS.md --dry-run',
		flags: [
			{ flag: '--dry-run', desc: 'Preview enrollments and exclusion edits without saving' },
			{ flag: '--skip-tracked', desc: 'Skip files the project repository already tracks' },
			{ flag: '--existing-exclude ask|preserve|abort', desc: 'How to handle existing .git/info/exclude rules' },
		],
	},
	{
		id: 'remove',
		sig: 'spas remove <path>...',
		desc: 'Untrack assets on the next sync. Files added but never synced are released immediately and left in place.',
		example: 'spas remove docs/team-notes.md',
		flags: [
			{ flag: '--missing-ok', desc: "Don't fail on paths SPAS doesn't manage" },
			{ flag: '--dry-run', desc: 'Preview removals without updating local state' },
		],
	},
	{
		id: 'sync',
		sig: 'spas sync [flags]',
		desc: 'Fetch the asset repository, commit your approved changes, merge remote updates, push without force, then write files into the workspace atomically.',
		example: 'spas sync --dry-run',
		flags: [
			{ flag: '-m, --message TEXT', desc: 'Commit message and approval for the asset commit' },
			{ flag: '--conflict ask|skip|override|abort', desc: 'Policy for collisions with tracked project paths' },
			{ flag: '--continue', desc: 'Resume after resolving a merge conflict' },
			{ flag: '--dry-run', desc: 'Read-only simulation: no locks, no network calls' },
		],
	},
	{
		id: 'status',
		sig: 'spas status',
		desc: 'Show link state, managed assets, path collisions, and pending recovery state.',
		example: 'spas status --json',
		flags: [
			{ flag: '--short', desc: 'Concise single-line summary' },
			{ flag: '--show-paths', desc: 'Absolute paths for the workspace and managed checkout' },
			{ flag: '--json', desc: 'Structured output for scripts' },
		],
	},
	{
		id: 'diff',
		sig: 'spas diff [--stat]',
		desc: 'Compare workspace assets against the managed checkout before anything gets committed.',
		example: 'spas diff --stat',
		flags: [
			{ flag: '--stat', desc: 'Summary of changes per file' },
			{ flag: '--name-only', desc: 'Changed paths only' },
			{ flag: '--staged', desc: 'Changes staged by an interrupted sync' },
		],
	},
	{
		id: 'doctor',
		sig: 'spas doctor',
		desc: 'Check Git configuration, path collisions, exclusion rules, merge protection, and recovery state, all offline.',
		example: 'spas doctor',
		flags: [
			{ flag: '--json', desc: 'A single diagnostic JSON object on stdout' },
			{ flag: '-v, --verbose', desc: 'Detailed logs, never asset contents' },
		],
	},
	{
		id: 'unlink',
		sig: 'spas unlink',
		desc: 'Detach the workspace and remove its exclusion rules. Files stay by default, and optional cleanup asks separately before discarding unsynced changes.',
		example: 'spas unlink',
		flags: [
			{ flag: '--remove-files', desc: 'Delete synced managed files from the workspace' },
			{ flag: '--discard-unsynced-changes', desc: 'Also discard unsynced edits when removing files' },
			{ flag: '--remove-private-clone', desc: 'Delete the local managed checkout too' },
		],
	},
	{
		id: 'completion',
		sig: 'spas completion <shell>',
		desc: 'Print shell completions for bash, zsh, fish, or PowerShell.',
		example: 'spas completion zsh > "${fpath[1]}/_spas"',
		flags: [],
	},
	{
		id: 'version',
		sig: 'spas version',
		desc: 'Print version, commit hash, and build metadata.',
		example: 'spas version',
		flags: [],
	},
];
---

<section id="commands" class="section relative mx-auto max-w-6xl px-5 md:px-8">
	<div class="max-w-2xl" data-reveal>
		<h2 class="section-title" data-split>
			The whole CLI is ten commands.
		</h2>
		<p class="section-lead">
			No daemon and no config file. Select a command to see its key flags.
		</p>
	</div>

	<div
		id="command-explorer"
		class="mt-10 overflow-hidden rounded-2xl border border-line bg-raised/60 md:mt-12 lg:grid lg:grid-cols-[280px_1fr]"
		data-reveal
	>
		<!-- command list -->
		<div
			class="flex overflow-x-auto border-b border-line lg:flex-col lg:overflow-visible lg:border-b-0 lg:border-r"
			role="tablist"
			aria-label="SPAS commands"
			aria-orientation="vertical"
		>
			{
				commands.map((c, i) => (
					<button
						type="button"
						role="tab"
						id={`cmd-tab-${c.id}`}
						aria-controls={`cmd-panel-${c.id}`}
						aria-selected={i === 3 ? 'true' : 'false'}
						tabindex={i === 3 ? 0 : -1}
						class="cmd-item shrink-0 whitespace-nowrap px-5 py-2.5 text-left font-mono text-[0.84rem] lg:whitespace-normal"
						data-cmd={c.id}
					>
						<span class="text-faint">spas</span> {c.id}
					</button>
				))
			}
		</div>

		<!-- detail panels (grid-stacked so height = tallest) -->
		<div class="grid">
			{
				commands.map((c, i) => (
					<div
						role="tabpanel"
						id={`cmd-panel-${c.id}`}
						aria-labelledby={`cmd-tab-${c.id}`}
						class:list={['cmd-panel col-start-1 row-start-1 p-6 md:p-8', { active: i === 3 }]}
						data-panel={c.id}
						aria-hidden={i === 3 ? 'false' : 'true'}
					>
						<code class="font-mono text-[0.95rem] font-medium text-accent-soft">{c.sig}</code>
						<p class="mt-3 max-w-xl text-[0.9rem] leading-relaxed text-dim">{c.desc}</p>
						<div class="mt-5 flex items-center gap-3 rounded-lg border border-line bg-ink/70 px-4 py-3">
							<span class="sx-prompt select-none font-mono text-[0.8rem]">$</span>
							<code class="min-w-0 flex-1 overflow-x-auto font-mono text-[0.78rem] text-text">
								{tokenizeCommand(c.example).map((t, i) => (<>{i > 0 && ' '}<span class={`sx-${t.kind}`}>{t.text}</span></>))}
							</code>
							<button
								class="copy-btn h-8 w-8 shrink-0 rounded-md"
								data-copy={c.example}
								aria-label={`Copy example: ${c.example}`}
							>
								<Icon name="copy" size={14} />
								<Icon name="check" size={14} class="hidden" />
							</button>
						</div>
						{c.flags.length > 0 && (
							<>
								<p class="ui-label mt-6 text-faint">Key flags</p>
								<dl class="mt-2.5 grid sm:grid-cols-[max-content_1fr] sm:gap-x-8 sm:gap-y-2">
									{c.flags.map((f) => (
										<>
											<dt class="mt-3 font-mono text-[0.78rem] text-accent-soft first:mt-0 sm:mt-0">
												{f.flag}
											</dt>
											<dd class="mt-0.5 text-[0.84rem] text-dim sm:mt-0">{f.desc}</dd>
										</>
									))}
								</dl>
							</>
						)}
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.cmd-panel {
		opacity: 0;
		translate: 0 8px;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 0.3s var(--ease-soft),
			translate 0.3s var(--ease-out-expo),
			visibility 0s 0.3s;
	}
	.cmd-panel.active {
		opacity: 1;
		translate: 0 0;
		visibility: visible;
		pointer-events: auto;
		transition:
			opacity 0.3s var(--ease-soft),
			translate 0.3s var(--ease-out-expo),
			visibility 0s 0s;
	}
</style>
