---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import geistWoff2 from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import spaceGroteskWoff2 from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { installGuideUrl } from '../lib/install';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = 'SPAS: Version and share files kept out of your Git repo',
	description = 'Open-source CLI that keeps test data, local setup, AI instructions, and internal docs out of your main repo, versioned in a GitHub repo you can share.',
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'WebSite', name: 'SPAS', url: 'https://getspas.dev' },
		{
			'@type': 'SoftwareApplication',
			name: 'SPAS',
			alternateName: 'Secure Private Asset Sync',
			description,
			url: 'https://getspas.dev',
			sameAs: ['https://github.com/getspas/spas'],
			isAccessibleForFree: true,
			installUrl: installGuideUrl,
			applicationCategory: 'DeveloperApplication',
			operatingSystem: 'Windows, macOS, Linux',
			softwareRequirements: 'Git 2.43.1 or newer',
			license: 'https://www.gnu.org/licenses/agpl-3.0.html',
			offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
			author: {
				'@type': 'Organization',
				name: 'SPAS contributors',
				url: 'https://github.com/getspas',
			},
			featureList: [
				'Keeps files at their normal paths in the workspace',
				'Excludes managed files through .git/info/exclude without editing .gitignore',
				'Versions managed files in a separate GitHub repository',
				'Shares the same files across machines and teammates',
				'Dry-run previews, advisory locks, atomic writes, and recovery state',
				'JSON output and documented exit codes for scripts and CI',
			],
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<script is:inline>
			document.documentElement.classList.add('js');
			const t = localStorage.getItem('theme');
			if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
		</script>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="SPAS" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="SPAS: Private files. Normal paths. Separate history. Version and share files kept out of your Git repo." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f8fb" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#070a10" />
		<link rel="preload" href={geistWoff2} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={spaceGroteskWoff2} as="font" type="font/woff2" crossorigin />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<div id="sr-status" class="sr-only" aria-live="polite"></div>
		<slot />
		<script>
			import '../scripts/main.ts';
		</script>
	</body>
</html>
