---
interface Props {
	size?: number;
	class?: string;
}
const { size = 30, class: className = '' } = Astro.props;
const h = Math.round(size * 0.78);
const w = Math.round(h * (662 / 853));
---

<span
	class:list={['logo-mark', className]}
	style={`width:${size}px;height:${size}px;`}
	role="img"
	aria-label="SPAS logo"
>
	<img src="/logo-mark.png" alt="" width={w} height={h} decoding="async" />
</span>
