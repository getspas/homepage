---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found · SPAS" description="This page doesn't exist." noindex>
	<Nav />
	<main id="main" class="flex min-h-[70dvh] items-center">
		<div class="mx-auto w-full max-w-6xl px-5 pb-16 pt-28 md:px-8">
			<p class="font-mono text-sm text-faint">404</p>
			<h1 class="section-title mt-3" data-split>
				Page not found.
			</h1>
			<p class="mt-4 text-dim">The page you're looking for doesn't exist or has moved.</p>
			<a href="/" class="btn btn-primary mt-8 h-11 px-5 text-[0.88rem]">Back to home</a>
		</div>
	</main>
	<Footer />
</Layout>
